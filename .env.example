# ==============================================================================
# WiseTrade Environment Variables Configuration
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. Any variable with the `VITE_` prefix is bundled into the client code by Vite
#    and will be VISIBLE TO EVERY VISITOR in the browser network tab & JS bundle.
# 2. PRIVATE SECRETS (such as OPENAI_API_KEY, private database keys, admin passwords)
#    must NEVER have a `VITE_` prefix and must NEVER be imported in client-side code.
# 3. In Vercel, configure these under: Project Settings -> Environment Variables.
#    Select target environment: "Production" (and optionally "Preview" / "Development").
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SECRETS (Vercel Serverless Functions / Node Server)
# [DO NOT PREFIX WITH VITE_] - Stays 100% on the server, invisible to browsers.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. FRONTEND PUBLIC VARIABLES (Vite Web App)
# [PREFIXED WITH VITE_] - Safe for client bundle. Identifies services.
# ------------------------------------------------------------------------------
# Firebase Web App Config (Found in Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSyAprGI70cv69zdLY71pZGLiUXUzcguPgRY
VITE_FIREBASE_AUTH_DOMAIN=wiestrade.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wiestrade
VITE_FIREBASE_STORAGE_BUCKET=wiestrade.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=440247174484
VITE_FIREBASE_APP_ID=1:440247174484:web:0ea29c2843ff046803f4c1
VITE_FIREBASE_MEASUREMENT_ID=G-0YK33TVC5R

# Optional: Custom API URL (Leave blank to use relative Vercel Serverless Function `/api`)
# VITE_API_URL=
